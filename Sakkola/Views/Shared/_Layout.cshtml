@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] Mercado Sakkola</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Sakkola.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="shortcut icon" href="~/img/Logo-White.png" />
</head>
<body class="@ViewData["TemaCategoria"] d-flex flex-column" style="min-height: 100vh;">

    @{
        var colaboradorEmail = Context.Session.GetString("EmailColaborador");
    }

    @if (string.IsNullOrEmpty(colaboradorEmail))
    {
        <header>
            <div class="header-sakkola py-2 text-white">
                <div class="py-2 d-flex align-items-center justify-content-between mx-4">
                    <a class="navbar-brand text-white fw-bold fs-3 me-3" asp-area="" asp-controller="Home" asp-action="Index">
                        <img src="~/img/Logo-Escrito-White.png" class="logo-header ms-0 justify-content-start" />
                    </a>
                    <form class="flex-grow-1 mx-5" asp-controller="Produtos" asp-action="Buscar" method="get">
                        <div class="input-group">
                            <input type="text" name="termo" class="form-control rounded-pill px-3 pe-5" placeholder="Buscar produtos..."/>
                            <button class="btn btn-search-icon position-absolute end-0 top-50 translate-middle-y z-3 border-0 bg-transparent" type="submit">
                                <i class="bi bi-search text-secondary"></i>
                            </button>
                        </div>
                    </form>

                    <div class="ms-5 justify-content-end d-flex align-items-center gap-3 fs-4">
                        <a asp-controller="Carrinho" asp-action="Index" class="text-white">
                            <i class="bi bi-cart3"></i>
                        </a>

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <a asp-controller="Account" asp-action="Perfil"
                               class="text-white position-relative"
                               title="Minha Conta"
                               style="cursor: pointer;">
                                <i class="bi bi-person-circle"></i>
                            </a>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Cadastro" class="text-white">
                                <i class="bi bi-person-circle"></i>
                            </a>
                        }
                    </div>
                </div>
            </div>

            <nav class="header-sakkola-2">
                <div class="me-0 gap-0 container d-flex justify-content-end">
                    <ul class="nav links-font-header py-1 gap-2">
                        <li class="nav-item">
                            <a class="nav-link text-white py-0 px-1 fw-semibold" asp-controller="Home" asp-action="Index">Início</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white py-0 px-1 fw-semibold"
                               href="#menuCategorias"
                               data-bs-toggle="offcanvas"
                               role="button"
                               aria-controls="menuCategorias">Categorias</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white py-0 px-1 fw-semibold" asp-controller="Home" asp-action="Promocoes">Promoções</a>
                        </li>
                    </ul>
                </div>
            </nav>
            <div class="offcanvas offcanvas-start" tabindex="-1" id="menuCategorias" aria-labelledby="menuCategoriasLabel" style="width:334px;">
                <div class="offcanvas-header flex-column align-items-start pb-2">
                    <div class="d-flex justify-content-around w-100 align-items-center mb-2">
                        <a asp-area="" asp-controller="Home" asp-action="Index">
                            <img src="~/img/logo-sakkola-color.png" alt="Sakkola logo" style="height: 80px;" />
                        </a>
                        <button type="button" class="btn-close position-absolute top-0 end-0 m-3" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                    </div>
                    <h5 class="offcanvas-title fw-bold text-secondary fs-5 mt-3" id="menuCategoriasLabel">
                        Categorias
                    </h5>
                </div>

                <div class="offcanvas-body p-0">
                    <div class="list-group list-group-flush">
                        <a asp-controller="Produtos" asp-action="Categoria" asp-route-id="Acougue" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3">
                            <span>Açougue</span>
                            <i class="bi bi-chevron-right fs-7" style="color:var(--verdinha)"></i>
                        </a>
                        <a asp-controller="Produtos" asp-action="Categoria" asp-route-id="Frios" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3">
                            <span>Frios e Laticínios</span>
                            <i class="bi bi-chevron-right fs-7" style="color:var(--verdinha)"></i>
                        </a>
                        <a asp-controller="Produtos" asp-action="Categoria" asp-route-id="Hortifruti" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3">
                            <span>Hortifrúti</span>
                            <i class="bi bi-chevron-right fs-7" style="color:var(--verdinha)"></i>
                        </a>
                        <a asp-controller="Produtos" asp-action="Categoria" asp-route-id="Mercearia" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3">
                            <span>Mercearia</span>
                            <i class="bi bi-chevron-right fs-7" style="color:var(--verdinha)"></i>
                        </a>
                        <a asp-controller="Produtos" asp-action="Categoria" asp-route-id="Higiene" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3">
                            <span>Higiene</span>
                            <i class="bi bi-chevron-right fs-7" style="color:var(--verdinha)"></i>
                        </a>
                        <a asp-controller="Produtos" asp-action="Categoria" asp-route-id="Limpeza" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3">
                            <span>Limpeza e Utilidades</span>
                            <i class="bi bi-chevron-right fs-7" style="color:var(--verdinha)"></i>
                        </a>
                        <a asp-controller="Produtos" asp-action="Categoria" asp-route-id="Padaria" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3">
                            <span>Padaria</span>
                            <i class="bi bi-chevron-right fs-7" style="color:var(--verdinha)"></i>
                        </a>
                    </div>
                </div>
            </div>
        </header>
    }
    else
    {
        <header class="bg-dark text-white py-3 shadow-sm mb-4">
            <div class="container-fluid d-flex justify-content-between align-items-center px-4">
                <div class="d-flex align-items-center gap-3">
                    <img src="~/img/Logo-Escrito-White.png" alt="Sakkola" style="height: 35px;" />
                    <span class="badge bg-danger">Painel do Colaborador</span>
                </div>
                <div class="d-flex align-items-center gap-4">
                    <ul class="navbar-nav flex-row align-items-center gap-3 m-0">
                        @if (Context.Session.GetString("ColaboradorAdmin") == "True")
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-light fw-semibold px-2 py-1 rounded" href="#" role="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-shield-lock me-1"></i> Administração
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end border-0 shadow rounded-3 mt-2">
                                    <li><a class="dropdown-item py-2" asp-controller="Colaborador" asp-action="CadastrarProduto">Cadastrar Produto</a></li>
                                    <li><a class="dropdown-item py-2" asp-controller="Colaborador" asp-action="GerenciarClientes">Gerenciar Clientes</a></li>
                                </ul>
                            </li>
                        }
                    </ul>

                    <div class="d-flex align-items-center gap-3 border-start ps-3 border-secondary">
                        <span class="small text-light">Logado como: <strong>@colaboradorEmail</strong></span>
                        <a asp-controller="Colaborador" asp-action="Logout" class="btn btn-outline-light btn-sm rounded-pill px-3">
                            <i class="bi bi-box-arrow-right"></i> Sair
                        </a>
                    </div>
                </div>
            </div>
        </header>
    }

    <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 1100">
        <div id="toastCarrinho" class="toast align-items-center text-white bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body">
                    <i class="bi bi-check-circle-fill me-2"></i> Produto adicionado ao carrinho com sucesso!
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>

    <div class="flex-grow-1">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    @if (string.IsNullOrEmpty(colaboradorEmail))
    {
        <footer class="mt-auto mb-0 pb-0 header-sakkola footer">
            <div class="d-flex align-items-center justify-content-between mx-4">
                <a class="navbar-brand text-white fw-bold me-3" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="/img/Logo-Escrito-White.png" class="logo-footer ms-0" style="height: 35px;"/>
                </a>
                <div class="ms-5 gap-4 justify-content-end d-flex align-items-center gap-3 fs-5">
                    <a asp-controller="carrinho" asp-action="Index" class="text-white">
                        <i class="bi bi-geo-alt"></i>
                    </a>
                    <a asp-controller="continha" asp-action="login" class="text-white">
                        <i class="bi bi-telephone"></i>
                    </a>
                    <a asp-controller="continha" asp-action="login" class="text-white">
                        <i class="bi bi-instagram"></i>
                    </a>
                </div>
            </div>
            <nav class="footer-nav d-flex align-items-center justify-content-center header-sakkola-2 text-white">
                <div class="container d-flex justify-content-center">
                    <ul class="nav">
                        <li>
                            <a class="font-footer nav-link text-white p-0 opacity-75">&copy; 2026 Copyright</a>
                        </li>
                        <li>
                            <a class="font-footer nav-link text-white py-0">Sakkola.com</a>
                        </li>
                    </ul>
                </div>
            </nav>
        </footer>
    }

    <script src="https://vlibras.gov.br/app/vlibras-plugin.js" defer></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>