<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] Mercado Sakkola</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Sakkola.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="shortcut icon" href="~/img/Logo-White.png" />
</head>
<body class="@ViewData["TemaCategoria"]">

    @{
        // Lê o e-mail da sessão do colaborador que definimos anteriormente
        var colaboradorEmail = Context.Session.GetString("EmailColaborador");
    }

    @if (string.IsNullOrEmpty(colaboradorEmail))
    {
        <!-- HEADER PÚBLICO -->
        <header>
            <div class="header-sakkola py-2 text-white">
                <div class="py-2 d-flex align-items-center justify-content-between mx-4">
                    <!-- Logo -->
                    <a class="navbar-brand text-white fw-bold fs-3 me-3" asp-area="" asp-controller="Home" asp-action="Index">
                        <img src="~/img/Logo-Escrito-White.png" class="logo-header ms-0 justify-content-start" />
                    </a>

                    <!-- Barra de Pesquisa -->
                    <form class="flex-grow-1 mx-5" asp-controller="Produtos" asp-action="Index" method="get">
                        <div class="input-group">
                            <input type="search" class="form-control rounded-pill px-3 pe-5" placeholder="Buscar produtos..." name="search" />
                            <button class="btn btn-search-icon position-absolute end-0 top-50 translate-middle-y z-3 border-0 bg-transparent" type="submit">
                                <i class="bi bi-search text-secondary"></i>
                            </button>
                        </div>
                    </form>

                    <div class="ms-5 justify-content-end d-flex align-items-center gap-3 fs-4">
                        <a asp-controller="Carrinho" asp-action="Index" class="text-white">
                            <i class="bi bi-cart3"></i>
                        </a>

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <a href="javascript:void(0)"
                               class="text-white position-relative"
                               data-bs-toggle="modal"
                               data-bs-target="#userProfileModal"
                               title="Minha Conta"
                               style="cursor: pointer;">
                                <i class="bi bi-person-circle"></i>
                            </a>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Cadastro" class="text-white">
                                <i class="bi bi-person-circle"></i>
                            </a>
                        }
                    </div>
                </div>
            </div>

            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <partial name="_UserProfileModal" />
            }

            <nav class="header-sakkola-2">
                <div class="me-0 gap-0 container d-flex justify-content-end">
                    <ul class="nav links-font-header py-1 gap-2">
                        <li class="nav-item">
                            <a class="nav-link text-white py-0 px-1 fw-semibold" asp-controller="Home" asp-action="Index">Início</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white py-0 px-1 fw-semibold"
                               href="#menuCategorias"
                               data-bs-toggle="offcanvas"
                               role="button"
                               aria-controls="menuCategorias">Categorias</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white py-0 px-1 fw-semibold" asp-controller="Home" asp-action="Promocoes">Promoções</a>
                        </li>
                    </ul>
                </div>
            </nav>

            <div class="offcanvas offcanvas-start" tabindex="-1" id="menuCategorias" aria-labelledby="menuCategoriasLabel" style="width:334px;">
                <!-- Offcanvas de categorias omitido para poupar espaço, mantenha o seu original aqui se desejar -->
            </div>
        </header>
    }
    else
    {
        <!-- HEADER EXCLUSIVO ADMIN -->
        <header class="bg-dark text-white py-3 shadow-sm mb-4">
            <div class="container-fluid d-flex justify-content-between align-items-center px-4">
                <div class="d-flex align-items-center gap-3">
                    <img src="~/img/Logo-Escrito-White.png" alt="Sakkola" style="height: 35px;" />
                    <span class="badge bg-danger">Painel do Colaborador</span>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <span class="small text-light">Logado como: <strong>@colaboradorEmail</strong></span>
                    <a asp-controller="Colaborador" asp-action="Logout" class="btn btn-outline-light btn-sm">
                        <i class="bi bi-box-arrow-right"></i> Sair
                    </a>
                </div>
            </div>
        </header>
    }

    <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 1100">
        <div id="toastCarrinho" class="toast align-items-center text-white bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body">
                    <i class="bi bi-check-circle-fill me-2"></i> Produto adicionado ao carrinho com sucesso!
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>

    <div>
        <main role="main" class="pb-3 mb-5">
            @RenderBody()
        </main>
    </div>

    <footer class="mt-5 mb-0 pb-0 header-sakkola footer">
        <div class="d-flex align-items-center justify-content-between mx-4 py-2">
        <!-- Logo Footer com tamanho controlado -->
            <a class="navbar-brand text-white fw-bold me-3" asp-area="" asp-controller="Home" asp-action="Index">
                <img src="~/img/Logo-Escrito-White.png" class="logo-footer ms-0" style="height: 35px;" />
            </a>
        
        <!-- Ícones de Redes/Contato -->
            <div class="ms-5 gap-3 justify-content-end d-flex align-items-center fs-5">
                <a asp-controller="Carrinho" asp-action="Index" class="text-white">
                    <i class="bi bi-geo-alt"></i>
                </a>
                <a asp-controller="Account" asp-action="Login" class="text-white">
                    <i class="bi bi-telephone"></i>
                </a>
                <a asp-controller="Account" asp-action="Login" class="text-white">
                    <i class="bi bi-instagram"></i>
                </a>
            </div>
        </div>

    <!-- Barra inferior de copyright bem compacta -->
        <nav class="footer-nav d-flex align-items-center justify-content-center header-sakkola-2 text-white py-1">
            <div class="container d-flex justify-content-center">
                <ul class="nav mb-0">
                    <li>
                        <a class="font-footer nav-link text-white p-0 opacity-75 small">&copy; 2026 Copyright</a>
                    </li>
                    <li class="ms-2">
                        <a asp-controller="Home" asp-action="Index" class="font-footer nav-link text-white p-0 small">Sakkola.com</a>
                    </li>
                </ul>
            </div>
        </nav>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>