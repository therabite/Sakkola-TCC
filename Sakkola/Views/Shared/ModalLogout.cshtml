<!-- Modal de Perfil -->
<div class="modal fade" id="userProfileModal" tabindex="-1" aria-labelledby="userProfileModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="userProfileModalLabel">Perfil do Usuário</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
      </div>
      <div class="modal-body text-center">
        <h4>Bem-vindo(a), @User.Identity?.Name! 👋</h4>
        <p class="text-muted">Você está atualmente conectado à sua conta.</p>
      </div>
      <div class="modal-footer justify-content-between">
        <!-- Botão para fechar/ignorar o pop-up -->
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>

        <!-- Formulário para efetuar o Logout de forma segura -->
        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-danger">Sair / Deslogar</button>
        </form>
      </div>
    </div>
  </div>
</div>