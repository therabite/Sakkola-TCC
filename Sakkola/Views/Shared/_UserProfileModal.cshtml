@model Sakkola.Models.ViewModel.UsuarioPerfilViewModel
@using System.Security.Claims
@{
    var perfil = Model ?? new Sakkola.Models.ViewModel.UsuarioPerfilViewModel
    {
        Nome = User.Identity?.Name ?? "",
        Email = User.FindFirst(ClaimTypes.Email)?.Value ?? "",
        Telefone = User.FindFirst("Telefone")?.Value ?? "",
        Cep = User.FindFirst("CEP")?.Value ?? "",
        Endereco = User.FindFirst("Endereco")?.Value ?? "",
        Numero = User.FindFirst("Numero")?.Value ?? "",
        Complemento = User.FindFirst("Complemento")?.Value ?? ""
    };
}

<div class="modal fade" id="userProfileModal" tabindex="-1" aria-labelledby="userProfileModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold text-dark" id="userProfileModalLabel">Minha Conta</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body px-4 pt-2 pb-4">
                
                <div class="text-center mb-4">
                    <h4 class="fw-normal mb-1">Bem-vindo(a), <strong>@perfil.Nome</strong>! 👋</h4>
                    <p class="text-muted small mb-0">Visualize e edite suas informações pessoais e endereço de entrega abaixo.</p>
                </div>

                <form asp-controller="Account" asp-action="AtualizarDados" method="post" id="formEditarPerfil">
                    
                    <!-- Seção: Dados Pessoais -->
                    <h6 class="fw-bold mb-3" style="color: #b02a1e;">Dados Pessoais</h6>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-secondary">Nome Completo</label>
                            <input type="text" class="form-control" name="Nome" value="@perfil.Nome" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-secondary">E-mail</label>
                            <input type="email" class="form-control bg-light" name="Email" value="@perfil.Email" readonly title="O e-mail não pode ser alterado" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-secondary">Telefone / WhatsApp</label>
                            <input type="text" class="form-control" id="modalTelefone" name="Telefone" value="@perfil.Telefone" placeholder="(11) 99999-9999" required />
                        </div>
                    </div>

                    <hr class="text-muted opacity-25 my-3" />

                    <!-- Seção: Informações de Entrega -->
                    <h6 class="fw-bold mb-3" style="color: #b02a1e;">Informações de Entrega</h6>
                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold text-secondary">CEP</label>
                            <input type="text" class="form-control" id="modalCep" name="CEP" value="@perfil.Cep" placeholder="00000-000" required />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label small fw-semibold text-secondary">Rua / Logradouro</label>
                            <input type="text" class="form-control" id="modalEndereco" name="Endereco" value="@perfil.Endereco" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold text-secondary">Número</label>
                            <input type="text" class="form-control" name="Numero" value="@perfil.Numero" required />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label small fw-semibold text-secondary">Complemento / Bairro</label>
                            <input type="text" class="form-control" id="modalComplemento" name="Complemento" value="@perfil.Complemento" placeholder="Apto, Bloco, Bairro..." />
                        </div>
                    </div>

                    <!-- Botão Salvar -->
                    <div class="d-flex justify-content-end mb-3">
                        <button type="submit" class="btn text-white px-4 fw-semibold" style="background-color: #198754;">
                            <i class="bi bi-check-lg me-1"></i> Salvar Alterações
                        </button>
                    </div>
                </form>

                <hr class="text-muted opacity-25 my-3" />

                <!-- Ações Inferiores -->
                <div class="d-flex justify-content-between align-items-center pt-1">
                    <a asp-controller="Pedidos" asp-action="MeusPedidos" class="btn btn-secondary px-4">
                        Meus Pedidos
                    </a>

                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                        <button type="submit" class="btn btn-danger px-4">
                            Sair / Deslogar
                        </button>
                    </form>
                </div>

            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        $('#userProfileModal').on('shown.bs.modal', function () {
            if ($.fn.mask) {
                $('#modalTelefone').mask('(00) 00000-0000').trigger('input');
                $('#modalCep').mask('00000-000').trigger('input');
            }
        });

        $('#modalCep').on('blur', function () {
            var cep = $(this).val().replace(/\D/g, '');

            if (cep !== "") {
                var validacep = /^[0-9]{8}$/;

                if (validacep.test(cep)) {
                    $('#modalEndereco').val("Carregando...");

                    $.getJSON("https://viacep.com.br/ws/" + cep + "/json/?callback=?", function (dados) {
                        if (!("erro" in dados)) {
                            $('#modalEndereco').val(dados.logradouro);
                            $('#modalComplemento').val(dados.bairro + (dados.complemento ? ' - ' + dados.complemento : ''));
                        } else {
                            $('#modalEndereco').val("");
                            alert("CEP não encontrado.");
                        }
                    });
                } else {
                    alert("Formato de CEP inválido.");
                }
            }
        });
    });
</script>