@model Sakkola.Models.ViewProdutos.Produtos
@{
    ViewData["Title"] = Model.nome + " - ";
    var sugestoes = ViewBag.Sugestoes as List<Sakkola.Models.ViewProdutos.Produtos>;
}

<div class="position-relative w-100 mb-4" style="height: 220px;">
    <img src="~/img/banners/@(ViewData["IdCategoria"]).jpeg"
         class="w-100 h-100 object-fit-cover position-absolute top-0 start-0"
         alt="@ViewData["NomeCategoria"]"
         onerror="this.src='/img/sakkola-banner-1.png';" />

    <div class="position-absolute top-0 start-0 w-100 h-100 bg-dark opacity-25"></div>

    <div class="position-absolute bottom-0 start-0 p-4 text-white z-2">
        <h1 class="fw-light text-uppercase fs-1 mb-1 ms-3">@ViewData["NomeCategoria"]</h1>
        <div class="ms-3 bg-white" style="height: 2px; width: 382.7px;"></div>
    </div>
</div>

<div class="container my-4">
    <div class="card border rounded-4 p-4 shadow-sm bg-white position-relative mx-auto" style="width: 1166px;">

        <a href="javascript:history.back()" class="text-secondary fs-4 mb-3 d-inline-block text-decoration-none">
            <i class="bi bi-arrow-left"></i>
        </a>

        <div class="row align-items-center">
            <div class="col-md-6 text-center border-end">
                <img src="~/img/produtos/@(Model.id).png"
                     class="img-fluid max-h-100"
                     alt="@Model.nome"
                     style="max-height:100%; object-fit:contain;"
                     onerror="this.src='/img/logo-sakkola-color-no-text.png';" />
            </div>

            <div class="col-md-6 ps-md-5">
                <h3 class="fw-bold text-dark mb-3">@Model.nome</h3>
                <p class="text-muted mb-4" style="font-size: 1.1rem;">
                    @(string.IsNullOrEmpty(Model.descricao) ? "Descrição detalhada do produto disponível em breve no Sakkola Market." : Model.descricao)
                </p>

                <div class="d-flex align-items-center justify-content-between mb-4">
                    <h2 class="text-success fw-bold m-0" style="color: #2E7D32 !important;">
                        R$ @Model.preco.ToString("N2")
                    </h2>    
                </div>

                <div class="input-group rounded-3 overflow-hidden border" style="width: 140px;">
                    <button class="btn btn-light border-0 px-3 fw-bold text-secondary" type="button" onclick="alterarQtd(-1)">-</button>
                    <input type="text" id="quantidadeInput" class="form-control text-center border-0 fw-bold bg-white text-secondary" value="1" readonly />
                    <button class="btn btn-light border-0 px-3 fw-bold text-secondary" type="button" onclick="alterarQtd(1)">+</button>
                </div>

                <div class="text-end mt-4">
                    <a asp-controller="Home" asp-action="Carrinho" class="text-dark text-decoration-none d-inline-flex align-items-center gap-2" onclick="mockCarrinho()">
                        <i class="bi bi-cart3 fs-1 text-dark"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-5 mx-auto" style="max-width: 1100px;">
        <h4 class="fw-semibold text-secondary mb-4 text-center text-md-start">Sugestões</h4>

        <div class="d-flex flex-wrap justify-content-center gap-4">
            @if (sugestoes != null && sugestoes.Any())
            {
                @foreach (var prod in sugestoes)
                {
                    <div style="width: 226px;">
                        <partial name="_CardProduto" model="prod" />
                    </div>
                }
            }
            else
            {
                <p class="text-muted text-center">Não há outros produtos disponíveis nesta categoria no momento.</p>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function alterarQtd(valor) {
            var input = document.getElementById('quantidadeInput');
            var atual = parseInt(input.value);
            var novo = atual + valor;
            if (novo >= 1) {
                input.value = novo;
            }
        }

        function mockCarrinho() {
            var qtd = document.getElementById('quantidadeInput').value;
            alert("Produto adicionado ao carrinho com sucesso! (Mockado: " + qtd + " unidade(s))");
        }
    </script>
}