@model IEnumerable<Sakkola.Models.ViewProdutos.Produtos>
@{
    ViewData["Title"] = ViewData["NomeCategoria"] + " - ";
}

<div class="position-relative w-100 mb-4" style="height: 220px;">
    <img src="~/img/banners/@(ViewData["IdCategoria"]).jpeg"
         class="w-100 h-100 object-fit-cover position-absolute top-0 start-0"
         alt="@ViewData["NomeCategoria"]"
         onerror="this.src='/img/sakkola-banner-1.png';" />

    <div class="position-absolute top-0 start-0 w-100 h-100 bg-dark opacity-25"></div>

    <div class="position-absolute bottom-0 start-0 p-4 text-white z-2">
        <h1 class="fw-light text-uppercase fs-1 mb-1 ms-3">@ViewData["NomeCategoria"]</h1>
        <div class="ms-3 bg-white" style="height: 2px; width: 382.7px;"></div>
    </div>
</div>

<div class="container-fluid px-5">
    <div class="div-da-linha d-flex justify-content-between align-items-center p-3 w-100 mb-2">
        <h3 class="fw-semibold text-black fs-4 m-0">Produtos em @ViewData["NomeCategoria"]</h3>
        <div class="linha flex-grow-1 ms-3"></div>
    </div>

    <div class="grid-ofertas-home mt-3 mb-5 mx-auto">
        @if (Model != null && Model?.Any() == true)
        {
            @foreach (var produto in Model.Take(12))
            {
                <partial name="_CardProduto" model="produto" />
            }
        }
        else
        {
            <p class="text-muted ms-3">Nenhum produto cadastrado no momento.</p>
        }
    </div>
</div>