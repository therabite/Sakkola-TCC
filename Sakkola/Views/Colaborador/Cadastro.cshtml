@model Sakkola.Models.ViewModel.RegisterColaborador
﻿@{
ViewData["Title"] = "Cadastro";
}
<div class="container mb-4 py-4">
    <div class="row align-items-center justify-content-sm-between g-5">
        <!-- Formulário de Cadastro (Esquerda) -->
        <div class="col-12 col-md-6 col-lg-5">
            <div class="card p-4 border rounded-1 mt-3">

                <form asp-action="Cadastro" method="post">
                    <div class="mb-3">
                        <label class="form-label">Nome Completo</label>
                        <input type="text" name="nome" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Data de Nascimento</label>
                        <!-- O name tem de ser exatamente "dataNasc" -->
                        <input type="date" name="dataNasc" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Telefone</label>
                        <!-- O name tem de ser exatamente "telefone" -->
                        <input type="number" name="telefone" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">CPF</label>
                        <!-- O name tem de ser exatamente "cpf" -->
                        <input type="number" name="cpf" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">E-mail Corporativo</label>
                        <input type="email" name="email" class="form-control" placeholder="usuario@admin" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Senha</label>
                        <input type="password" name="senha" class="form-control" maxlength="8" required />
                    </div>

                    <div class="mb-3 form-check">
                        <input type="checkbox" name="isAdmin" value="true" class="form-check-input" id="checkAdmin" />
                        <label class="form-check-label" for="checkAdmin">Conceder privilégios de Administrador</label>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Cadastrar Funcionário</button>
                </form>

            </div>
        </div>

        <!-- Ilustração da Sakkola (Direita) -->
        <div class="col-12 col-md-6 text-center">
            <img src="~/img/Logo.png" alt="Sakkola Ilustração" style="max-height: 50vh; opacity: 30%;" />
        </div>

    </div>
</div>
@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery.mask/1.14.16/jquery.mask.min.js"></script>

    <script>
        $(document).ready(function () {
            $('#dataNasc').mask('00/00/0000');
            $('#cep').mask('00000-000');
            $('#cpf').mask('000.000.000-00', { reverse: true });

            var maskBehavior = function (val) {
                return val.replace(/\D/g, '').length === 11 ? '(00) 00000-0000' : '(00) 0000-00009';
            },
            options = {
                onKeyPress: function(val, e, field, options) {
                    field.mask(maskBehavior.apply({}, arguments), options);
                }
            };
            $('#telefone').mask(maskBehavior, options);
        });
    </script>
}