@model IEnumerable<Sakkola.Models.Pedido>

@{
    ViewData["Title"] = "Painel de Pedidos";
    string statusAtual = ViewBag.StatusSelecionado as string ?? "Todos";
    string idPedidoFiltro = ViewBag.IdPedidoFiltro?.ToString() ?? "";

    var opcoesStatus = new[]
    {
        new { Valor = "Todos", Texto = "Todos", Icone = "bi-grid", AtivoClass = "btn-dark" },
        new { Valor = "Pendente", Texto = "Pendentes", Icone = "bi-clock", AtivoClass = "btn-warning text-dark" },
        new { Valor = "Pago", Texto = "Pagos", Icone = "bi-check-circle", AtivoClass = "btn-success" },
        new { Valor = "Aprovado", Texto = "Aprovados", Icone = "bi-truck", AtivoClass = "btn-primary" },
        new { Valor = "Cancelado", Texto = "Cancelados", Icone = "bi-x-circle", AtivoClass = "btn-danger" }
    };

}


<div class="container my-5">
    <!-- Cabeçalho do Painel -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Painel de Pedidos</h2>
            <p class="text-muted m-0">Acompanhe os pedidos efetuados pelos clientes em tempo real.</p>
        </div>
    </div>
    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["Sucesso"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
        </div>
    }
    @if (TempData["Erro"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Erro"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
        </div>
    }
    <form method="get" asp-action="PainelPedidos" id="formFiltroPedidos" class="bg-white p-3 rounded-4 shadow-sm border mb-4">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div class="d-flex flex-wrap align-items-center gap-2">
                <span class="text-muted small fw-semibold me-1">
                    <i class="bi bi-funnel me-1"></i> Status:
                </span>

                <input type="hidden" name="status" id="statusInput" value="@statusAtual" />

                @foreach (var op in opcoesStatus)
                {
                    var isAtivo = string.Equals(statusAtual, op.Valor, StringComparison.OrdinalIgnoreCase);
                    <button type="button"
                            data-status="@op.Valor"
                            class="btn btn-sm rounded-pill px-3 py-2 fw-semibold btn-filtro-status @(isAtivo ? op.AtivoClass : "btn-light text-secondary border")">
                        <i class="bi @op.Icone me-1"></i> @op.Texto
                    </button>
                }
            </div>
            <div class="d-flex align-items-center gap-2">
                @if (!string.IsNullOrEmpty(ViewBag.IdPedidoFiltro?.ToString()) || !string.Equals(statusAtual, "Todos", StringComparison.OrdinalIgnoreCase))
                {
                    <a asp-action="PainelPedidos" class="btn btn-sm btn-link text-decoration-none text-muted px-1" title="Limpar filtros">
                        Limpar
                    </a>
                }
            </div>
        </div>
    </form>

    @if (Model == null || !Model.Any())
    {
        <div class="card shadow-sm border-0 p-5 text-center bg-light rounded-4">
            <h4 class="text-muted fw-normal">Nenhum pedido encontrado no momento.</h4>
            <p class="text-muted small mt-2">Assim que os clientes finalizarem compras, eles aparecerão aqui.</p>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 rounded-4 bg-white">
            <div class="bg-light border-bottom py-3 px-4 rounded-top-4 d-none d-md-block text-muted fw-bold small text-uppercase">
                <div class="row align-items-center">
                    <div class="col-md-2">ID Pedido / Cliente</div>
                    <div class="col-md-3">Data do Pedido</div>
                    <div class="col-md-2">Valor Total</div>
                    <div class="col-md-2">Status</div>
                    <div class="col-md-3 text-end">Ações</div>
                </div>
            </div>

            <div class="p-3 d-flex flex-column gap-3">
                @foreach (var pedido in Model)
                {
                    var status = pedido.StatusPedido?.Trim() ?? "Pendente";

                    <div class="p-3 border rounded-3 shadow-sm bg-white">
                        <div class="row align-items-center gy-2">
                            <div class="col-6 col-md-2">
                                <span class="fw-bold text-primary fs-5 d-block">#@pedido.IdPedido</span>
                                <span class="text-muted small">Cliente ID: @pedido.IdCliente</span>
                            </div>
                            <div class="col-6 col-md-3 text-secondary fw-medium">
                                <i class="bi bi-calendar-event me-1"></i>
                                @if (pedido.DataPedido != DateTime.MinValue)
                                {
                                    @pedido.DataPedido.ToString("dd/MM/yyyy HH:mm")
                                }
                                else
                                {
                                    <span class="text-muted fst-italic small">Data não informada</span>
                                }
                            </div>
                            <div class="col-6 col-md-2 fw-bold" style="color: var(--verdinha, #198754);">
                                R$ @pedido.ValorTotal.ToString("N2")
                            </div>
                            <div class="col-6 col-md-2">
                                @if (string.Equals(status, "Pago", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success px-3 py-2 rounded-pill fw-semibold">
                                        <i class="bi bi-check-circle me-1"></i> @status
                                    </span>
                                }
                                else if (string.Equals(status, "Aprovado", StringComparison.OrdinalIgnoreCase))
                                {   
                                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary px-3 py-2 rounded-pill fw-semibold">
                                        <i class="bi bi-truck me-1"></i> @status
                                    </span>
                                }
                                else if (string.Equals(status, "Pendente", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="badge bg-warning bg-opacity-10 text-warning border border-warning px-3 py-2 rounded-pill fw-semibold text-dark">
                                        <i class="bi bi-clock me-1"></i> @status
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger px-3 py-2 rounded-pill fw-semibold">
                                        <i class="bi bi-x-circle me-1"></i> @status
                                    </span>
                                }
                            </div>
                            <div class="col-12 col-md-3 d-flex justify-content-md-end align-items-center gap-2">
                                @if (!string.Equals(status, "Cancelado", StringComparison.OrdinalIgnoreCase))
                                {
                                    @if (string.Equals(status, "Pago", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <form asp-action="AtualizarStatus"
                                              method="post"
                                              class="m-0"
                                              onsubmit="return confirmarSaidaEntrega(@pedido.IdPedido);">
                                            <input type="hidden" name="idPedido" value="@pedido.IdPedido" />
                                            <input type="hidden" name="novoStatus" value="Aprovado" />
                                            <button type="submit" class="btn btn-outline-success btn-sm rounded-pill px-3 fw-medium">
                                                <i class="bi bi-check-lg me-1"></i>Aprovar
                                            </button>
                                        </form>
                                    }

                                    <form asp-action="AtualizarStatus"
                                          method="post"
                                          class="m-0"
                                          onsubmit="return confirm('Deseja realmente cancelar o pedido #@pedido.IdPedido?');">
                                        <input type="hidden" name="idPedido" value="@pedido.IdPedido" />
                                        <input type="hidden" name="novoStatus" value="Cancelado" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3 fw-medium">
                                            <i class="bi bi-x-lg me-1"></i>Cancelar
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted small fst-italic">Sem ações</span>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

<script>
    document.querySelectorAll('.btn-filtro-status').forEach(btn => {
        btn.addEventListener('click', function () {
            document.getElementById('statusInput').value = this.getAttribute('data-status');
            document.getElementById('formFiltroPedidos').submit();
        });
    });

    function confirmarSaidaEntrega(idPedido) {
        return confirm("Aviso: o pedido #" + idPedido + " já foi pago e irá sair para entrega. Deseja confirmar a aprovação?");
    }
</script>