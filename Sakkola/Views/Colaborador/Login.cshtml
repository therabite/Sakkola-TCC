@model Sakkola.Models.ViewModel.LoginColaborador
@{
    ViewData["Title"] = "Login do Colaborador";
    Layout = "~/Views/Shared/_LayoutAcesso.cshtml";
}

<div class="container d-flex justify-content-center align-items-center min-vh-100 py-4">
    <div class="row justify-content-center w-100">
        <div class="col-12 col-md-7 col-lg-5">
            <div class="card p-4 border rounded-1 shadow-sm">

                <!-- Logo -->
                <div class="text-center mb-4">
                    <a class="navbar-brand text-white fw-bold fs-3" asp-area="" asp-controller="home" asp-action="Index">
                        <img src="~/img/Logo-Escrito-Black.png" style="height: 60px;" alt="Sakkola" />
                    </a>
                </div>

                <form asp-controller="Colaborador" asp-action="Login" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

                    <!-- Email -->
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-medium text-dark mb-1">Email</label>
                        <input asp-for="Email" class="sem-foco form-control rounded-2" placeholder="Digite seu email aqui" style="height: 50px;" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <!-- Senha -->
                    <div class="mb-4">
                        <label asp-for="Senha" class="form-label fw-medium text-dark mb-1">Senha</label>
                        <input asp-for="Senha" type="password" class="sem-foco form-control rounded-2" placeholder="********" style="height: 50px;" />
                        <span asp-validation-for="Senha" class="text-danger small"></span>
                    </div>

                    <!-- Botão Entrar -->
                    <button type="submit" class="btn btn-dark w-100 py-2 fw-semibold rounded-3 shadow-sm mb-3">
                        Entrar no Painel
                    </button>

                    <!-- Link Cadastrar -->
                    <div class="text-center small">
                        <span class="text-dark">Não possui cadastro? </span>
                        <a asp-controller="Colaborador" asp-action="Cadastro" class="fw-bold text-decoration-none" style="color: #4CAF50;">CADASTRAR</a>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>