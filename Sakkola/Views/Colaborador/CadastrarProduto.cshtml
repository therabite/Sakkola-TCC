@{
    ViewData["Title"] = "Cadastrar Produto - Sakkola";
}

<div class="container my-5" style="max-width: 900px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark">Cadastro de Produtos</h2>
            <p class="text-muted m-0">Adicione novos itens e categorias ao catálogo da Sakkola.</p>
        </div>
        <a asp-controller="Colaborador" asp-action="GerenciarProdutos" class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-semibold">
            <i class="bi bi-box-seam me-1"></i> Gerenciar Produtos
        </a>
        <a asp-controller="Colaborador" asp-action="PainelPedidos" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            Voltar ao Painel
        </a>
    </div>

    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Sucesso"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border shadow-sm rounded-4 p-4 bg-white">
        <form asp-controller="Colaborador" asp-action="CadastrarProduto" method="post" enctype="multipart/form-data">
            
            <div class="mb-3">
                <label class="form-label fw-semibold text-secondary">Nome do Produto</label>
                <input type="text" name="Nome" class="form-control rounded-3" placeholder="Ex: Picanha Bovina" required />
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold text-secondary">Descrição</label>
                <textarea name="Descricao" class="form-control rounded-3" rows="3" placeholder="Ex: Peça embalada a vácuo 1kg" required></textarea>
            </div>

            <div class="row mb-3">
                <div class="col-md-4">
                    <label class="form-label fw-semibold text-secondary">Preço (R$)</label>
                    <input type="number" step="0.01" name="Preco" class="form-control rounded-3" placeholder="0,00" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold text-secondary">Estoque Inicial</label>
                    <input type="number" name="Estoque" class="form-control rounded-3" placeholder="0" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold text-secondary">Categoria</label>
                    <div class="dropdown w-100">
                        <button class="btn bg-white border w-100 text-start d-flex justify-content-between align-items-center rounded-3 py-2 px-3 shadow-none text-secondary" 
                                type="button" 
                                id="dropdownCategoriaButton" 
                                data-bs-toggle="dropdown" 
                                aria-expanded="false"
                                style="border-color: #dee2e6 !important;">
                            <span class="d-flex align-items-center text-truncate">
                                <i class="bi bi-tag text-muted me-2"></i>
                                <span id="textoSelecionado">Selecione uma categoria...</span>
                            </span>
                            <i class="bi bi-chevron-down small text-muted"></i>
                        </button>       
                        <input type="hidden" name="Categoria" id="inputCategoriaHidden" value="" required />
                        <ul class="dropdown-menu dropdown-menu-end border-0 shadow rounded-3 mt-1 w-100 py-2" aria-labelledby="dropdownCategoriaButton">
                        @if (ViewBag.Categorias != null)
                        {
                            foreach (var cat in ViewBag.Categorias)
                            {
                                <li>
                                    <a class="dropdown-item py-2 px-3 text-dark" href="#" onclick="selecionarCategoria('@cat.Text', event)">
                                        @cat.Text
                                    </a>
                                </li>
                            }
                        }
                        </ul>
                    </div>
                </div>
            <div class="mb-4">
                <label class="form-label fw-semibold text-secondary">Imagem do Produto (PNG/JPG)</label>
                <input type="file" name="Imagem" class="form-control rounded-3" accept="image/*" />
                <small class="text-muted">A imagem será salva automaticamente vinculada ao ID gerado do produto.</small>
            </div>

            <div class="text-end">
                <button type="submit" class="btn text-white px-5 rounded-pill fw-semibold shadow-sm" style="background-color: var(--batom-de-paty);">
                    Cadastrar Produto
                </button>
            </div>

        </form>
    </div>
</div>
@section Scripts {
    <script>
        function selecionarCategoria(nomeCategoria, event) {
            event.preventDefault();
            document.getElementById('textoSelecionado').innerText = nomeCategoria;
            document.getElementById('textoSelecionado').classList.remove('text-muted');
            document.getElementById('textoSelecionado').classList.add('text-dark', 'fw-semibold');
            document.getElementById('inputCategoriaHidden').value = nomeCategoria;
        }
    </script>
}