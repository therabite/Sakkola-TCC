@model IEnumerable<Sakkola.Models.ViewProdutos.Produtos>

@{
    ViewData["Title"] = "Gerenciar Produtos - Sakkola";
}

<div class="container my-5" style="max-width: 1100px;">
    <!-- Cabeçalho -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark">Gerenciamento de Produtos</h2>
            <p class="text-muted m-0">Acompanhe, edite ou remova os itens cadastrados no catálogo.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Produtos" asp-action="Cadastrar" class="btn text-white btn-sm rounded-pill px-3 shadow-sm" style="background-color: var(--batom-de-paty);">
                <i class="bi bi-plus-lg me-1"></i> Novo Produto
            </a>
            <a asp-controller="Colaborador" asp-action="PainelPedidos" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                Voltar ao Painel
            </a>
        </div>
    </div>

    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Sucesso"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border shadow-sm rounded-4 p-4 bg-white">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="text-secondary small text-uppercase border-bottom">
                    <tr>
                        <th class="py-3">Produto</th>
                        <th class="py-3">Preço</th>
                        <th class="py-3">Estoque</th>
                        <th class="py-3 text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var produto in Model)
                        {
                            <tr>
                                <td class="py-3">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="bg-light border rounded-3 p-1 d-inline-flex align-items-center justify-content-center overflow-hidden" style="width: 50px; height: 50px;">
                                            <img src="~/img/img-produtos/@(produto.id).png" alt="Produto" class="object-fit-cover w-100 h-100" onerror="this.src='/img/logo-sakkola-color-no-text.png';" />
                                        </div>
                                        <div>
                                            <h6 class="fw-bold text-dark mb-0">@produto.nome</h6>
                                            <small class="text-muted text-truncate d-inline-block" style="max-width: 250px;">@produto.descricao</small>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-3 fw-semibold text-success">
                                    R$ @produto.preco.ToString("N2")
                                </td>
                                <td class="py-3">
                                    <span class="badge bg-light text-dark border px-2 py-1">@produto.estoque un.</span>
                                </td>
                                <td class="py-3 text-end">
                                    <div class="d-flex justify-content-end gap-2">
                                        <a asp-controller="Colaborador" asp-action="Editar" asp-route-id="@produto.id" class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-semibold">
                                            <i class="bi bi-pencil me-1"></i> Editar
                                        </a>

                                        <form asp-controller="Colaborador" asp-action="DeletarProduto" asp-route-id="@produto.id" method="post" onsubmit="return confirm('Deseja realmente excluir este produto?');" class="d-inline">
                                            <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3 fw-semibold">
                                                <i class="bi bi-trash me-1"></i> Deletar
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5 text-muted">
                                Nenhum produto cadastrado no momento.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>