@model IEnumerable<Sakkola.Models.ViewProdutos.Produtos>

@{
    ViewData["Title"] = "Gerenciar Produtos - Sakkola";
}

<div class="container my-5" style="max-width: 1100px;">
    <!-- Cabeçalho -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark">Gerenciamento de Produtos</h2>
            <p class="text-muted m-0">Acompanhe, edite ou remova os itens cadastrados no catálogo.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Colaborador" asp-action="CadastrarProduto" class="btn text-white btn-sm rounded-pill px-3 shadow-sm" style="background-color: var(--batom-de-paty);">
                <i class="bi bi-plus-lg me-1"></i> Novo Produto
            </a>
            <a asp-controller="Colaborador" asp-action="PainelPedidos" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                Voltar ao Painel
            </a>
        </div>
    </div>

    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Sucesso"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    <div class="card border shadow-sm rounded-4 p-3 bg-white mb-4">
        <form method="get" asp-action="GerenciarProdutos" class="row g-3 align-items-center">
            <div class="col-md-6">
                <div class="rounded-3 ">
                    <input type="text" name="termoBusca" value="@ViewBag.TermoBusca" class="form-control border shadow-none ps-2" placeholder="Pesquisar por nome ou descrição..." />
                </div>
            </div>
            <div class="col-md-4">
                <div class="dropdown w-100">
                    <button class="btn bg-white border w-100 text-start d-flex justify-content-between align-items-center rounded-3 py-2 px-3 shadow-none text-secondary" 
                            type="button" 
                            id="dropdownCategoriaBusca" 
                            data-bs-toggle="dropdown" 
                            aria-expanded="false"
                            style="border-color: #dee2e6 !important;">
                        <span class="d-flex align-items-center text-truncate">
                            <i class="bi bi-tag text-muted me-2"></i>
                            <span id="textoCategoriaSelecionada">@(string.IsNullOrEmpty(ViewBag.CategoriaSelecionada) ? "Todas as categorias" : ViewBag.CategoriaSelecionada)</span>
                        </span>
                        <i class="bi bi-chevron-down small text-muted"></i>
                    </button>
                    <input type="hidden" name="categoria" id="inputCategoriaBuscaHidden" value="@ViewBag.CategoriaSelecionada" />

                    <ul class="dropdown-menu dropdown-menu-end border-0 shadow rounded-3 mt-1 w-100 py-2" aria-labelledby="dropdownCategoriaBusca">
                        <li>
                            <a class="dropdown-item py-2 px-3 text-dark" href="#" onclick="selecionarCategoriaFiltro('', 'Todas as categorias', event)">
                                Todas as categorias
                            </a>
                        </li>
                        @if (ViewBag.Categorias != null)
                        {
                            foreach (var cat in ViewBag.Categorias)
                            {
                                <li>
                                    <a class="dropdown-item py-2 px-3 text-dark" href="#" onclick="selecionarCategoriaFiltro('@cat.Text', '@cat.Text', event)">
                                        @cat.Text
                                    </a>
                                </li>
                            }
                        }
                    </ul>
                </div>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn text-white w-100 rounded-pill shadow-sm fw-semibold" style="background-color: var(--batom-de-paty);">Filtrar</button>
                <a asp-action="GerenciarProdutos" class="btn btn-outline-secondary w-100 rounded-pill">Limpar</a>
            </div>
        </form>
    </div
    <div class="card border shadow-sm rounded-4 p-4 bg-white">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="text-secondary small text-uppercase border-bottom">
                    <tr>
                        <th class="py-3">Produto</th>
                        <th class="py-3">Preço</th>
                        <th class="py-3">Estoque</th>
                        <th class="py-3 text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var produto in Model)
                        {
                            <tr>
                                <td class="py-3">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="bg-light border rounded-3 p-1 d-inline-flex align-items-center justify-content-center overflow-hidden" style="width: 50px; height: 50px;">
                                            <img src="~/img/img-produtos/@(produto.id).png" alt="Produto" class="object-fit-cover w-100 h-100" onerror="this.src='/img/logo-sakkola-color-no-text.png';" />
                                        </div>
                                        <div>
                                            <h6 class="fw-bold text-dark mb-0">@produto.nome</h6>
                                            <small class="text-muted text-truncate d-inline-block" style="max-width: 250px;">@produto.descricao</small>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-3 fw-semibold text-success">
                                    R$ @produto.preco.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))
                                </td>
                                <td class="py-3">
                                    <span class="badge bg-light text-dark border px-2 py-1">@produto.estoque un.</span>
                                </td>
                                <td class="py-3 text-end">
                                    <div class="d-flex justify-content-end gap-2">
                                        <a asp-controller="Colaborador" asp-action="Editar" asp-route-id="@produto.id" class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-semibold">
                                            <i class="bi bi-pencil me-1"></i> Editar
                                        </a>
                                        <form asp-controller="Colaborador" asp-action="DeletarProduto" asp-route-id="@produto.id" method="post" onsubmit="return confirm('Deseja realmente excluir este produto?');" class="d-inline">
                                            <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3 fw-semibold">
                                                <i class="bi bi-trash me-1"></i> Deletar
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5 text-muted">
                                Nenhum produto encontrado com os filtros selecionados.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        function selecionarCategoriaFiltro(valor, nomeExibicao, event) {
            event.preventDefault();
            document.getElementById('textoCategoriaSelecionada').innerText = nomeExibicao;
            document.getElementById('textoCategoriaSelecionada').classList.remove('text-muted');
            document.getElementById('textoCategoriaSelecionada').classList.add('text-dark', 'fw-semibold');
            document.getElementById('inputCategoriaBuscaHidden').value = valor;
        }
    </script>
}